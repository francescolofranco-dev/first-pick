 "mechanics": [
    {
      "name": "Raid",
      "summary": "Raid abilities reward you for having attacked during the current turn, whether or not the attacker connected or survived combat.",
   "sourceIds": ["fdn-mechanics","fdn-release-notes"]
  },
    {
      "name": "Kicker",
      "summary": "Kicker is an optional extra cost paid while casting a spell; paying it unlocks the additional effect printed on that card.",
   "sourceIds": ["fdn-mechanics","fdn-release-notes"]
  },
    {
      "name": "Landfall",
      "summary": "Landfall abilities trigger whenever a land enters the battlefield under your control, rewarding land drops beyond simply making mana.",
   "sourceIds": ["fdn-mechanics","fdn-release-notes"]
  },
    {
      "name": "Treasure",
      "summary": "A Treasure is an artifact token you can tap and sacrifice to add one mana of any color, providing temporary acceleration or fixing.",
   "sourceIds": ["fdn-mechanics","fdn-release-notes"]
  },
    {
      "name": "Flashback",
      "summary": "You may cast a card with flashback from your graveyard for its flashback cost; after that spell leaves the stack, it is exiled.",
   "sourceIds": ["fdn-mechanics","fdn-release-notes"]
  }
