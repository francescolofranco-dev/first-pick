 "mechanics": [
    {
      "name": "Gift",
      "summary": "As you cast the spell, you may promise its listed benefit to an opponent as an optional additional cost; doing so upgrades or changes the spell's other effect.",
   "sourceIds": ["blb-mechanics","blb-release-notes"]
  },
    {
      "name": "Offspring",
      "summary": "You may pay the offspring cost as you cast a creature; when it enters, that payment creates a 1/1 token copy with the same abilities.",
   "sourceIds": ["blb-mechanics","blb-release-notes"]
  },
    {
      "name": "Surveil",
      "summary": "Look at the top cards of your library, put any of them into your graveyard, and leave the rest on top in any order.",
   "sourceIds": ["blb-mechanics","blb-release-notes"]
  },
    {
      "name": "Food",
      "summary": "A Food is an artifact token you can pay two mana, tap, and sacrifice to gain 3 life; it can instead supply the Food option when you forage.",
   "sourceIds": ["blb-mechanics","blb-release-notes"]
  },
    {
      "name": "Valiant",
      "summary": "Valiant abilities trigger the first time each turn that your own spell or ability targets that creature, including during an opponent's turn.",
   "sourceIds": ["blb-mechanics","blb-release-notes"]
  }
 ],
