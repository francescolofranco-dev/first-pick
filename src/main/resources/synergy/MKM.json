  },
    {
      "name": "Disguise",
      "summary": "A disguise card may be cast face down for three mana as a 2/2 creature with ward {2}, then turned face up by paying its disguise cost.",
   "sourceIds": ["mkm-mechanics","mkm-release-notes"]
  },
