 "mechanics": [
    {
      "name": "Transform",
      "summary": "A transforming double-faced card begins on its front face and turns to its back face only when an effect or its own instructions tell it to transform.",
   "sourceIds": ["lci-mechanics","lci-release-notes"]
  },
    {
      "name": "Explore",
      "summary": "Reveal the top card of your library: put a revealed land into your hand, or put a +1/+1 counter on the exploring creature and keep or mill the nonland card.",
   "sourceIds": ["lci-mechanics","lci-release-notes"]
  },
    {
      "name": "Discover",
      "summary": "Exile cards from the top until you find a nonland card within the stated mana value, then cast it for free or put it into your hand.",
   "sourceIds": ["lci-mechanics","lci-release-notes"]
  },
    {
      "name": "Craft",
      "summary": "At sorcery speed, pay a permanent's craft cost and exile it plus the listed materials from your battlefield or graveyard to return it transformed.",
   "sourceIds": ["lci-mechanics","lci-release-notes"]
  },
    {
      "name": "Descend",
      "summary": "You descend whenever a permanent card enters your graveyard; related abilities may check that event or count permanent cards there for descend thresholds.",
   "sourceIds": ["lci-mechanics","lci-release-notes"]
  }
