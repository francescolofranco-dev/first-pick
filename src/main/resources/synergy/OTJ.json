 "mechanics": [
    {
      "name": "Plot",
      "summary": "At sorcery speed, pay a card's plot cost to exile it from your hand; on a later turn, you may cast it from exile for free as a sorcery.",
   "sourceIds": ["otj-mechanics","otj-release-notes"]
  },
    {
      "name": "Spree",
      "summary": "A spree spell asks you to choose one or more modes and pay each chosen mode's additional cost, with every selected mode used once.",
   "sourceIds": ["otj-mechanics","otj-release-notes"]
  },
    {
      "name": "Saddle",
      "summary": "At sorcery speed, tap other creatures with enough total power to saddle a Mount for the turn and enable its saddled rewards when it attacks.",
   "sourceIds": ["otj-mechanics","otj-release-notes"]
  },
    {
      "name": "Treasure",
      "summary": "A Treasure is an artifact token you can tap and sacrifice to add one mana of any color, providing temporary acceleration or fixing.",
   "sourceIds": ["otj-mechanics","otj-release-notes"]
  },
    {
      "name": "Surveil",
      "summary": "Look at the top cards of your library, put any of them into your graveyard, and leave the rest on top in any order.",
   "sourceIds": ["otj-mechanics","otj-release-notes"]
  }
 ],
